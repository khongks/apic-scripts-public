#!/bin/bash

APIC_CLI=apic

CP4I_NAMESPACE=integration
APIC_NAMESPACE=apic
APIC_RELEASE_NAME=apim

if [[ -z $CMC_ADMIN_USER ]]; then
    CMC_ADMIN_USER="admin"
fi
if [[ -z $CMC_ADMIN_PASS ]]; then
    CMC_ADMIN_PASS=`oc -n ${APIC_NAMESPACE} get secret ${APIC_RELEASE_NAME}-mgmt-admin-pass -o jsonpath="{.data.password}" --ignore-not-found | base64 -d`
fi
if [[ -z $CMC_SERVER ]]; then
    CMC_SERVER=`oc get route -n ${APIC_NAMESPACE} ${APIC_RELEASE_NAME}-mgmt-platform-api -o jsonpath="{.spec.host}" --ignore-not-found`
fi
if [[ -z $APIMGR_SERVER ]]; then
    APIMGR_SERVER=`oc get route -n ${APIC_NAMESPACE} ${APIC_RELEASE_NAME}-mgmt-api-manager -o jsonpath="{.spec.host}" --ignore-not-found`
fi

CMC_ADMIN_REALM="admin/default-idp-1"

# echo "cloud-admin-ui-endpoint: ${CMC_SERVER}"
# echo "api-manager-ui-endpoint: ${APIMGR_SERVER}"

## APIC_TOKEN="23571382-9330-40b6-ba63-d5505ac5affc"

##
## Common variables
##
ADMIN_ORG_NAME="admin"
AVAILABILITY_ZONE=availability-zone-default

##
## Default services name
##
ANALYTICS_SERVICE_NAME=analytics-service
PORTAL_SERVICE_NAME=portal-service
GATEWAY_SERVICE_NAME="api-gateway-service"